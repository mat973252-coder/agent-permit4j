<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.agentpermit4j</groupId>
    <artifactId>agent-permit4j</artifactId>
    <version>0.5.0</version>
  </parent>
  <artifactId>agent-permit-spring-boot-starter</artifactId>
  <name>AgentPermit4j :: Spring Boot Starter</name>
  <dependencies>
    <dependency>
      <groupId>io.github.agentpermit4j</groupId>
      <artifactId>agent-permit-spring-boot-autoconfigure</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>candidate</id>
      <build>
        <plugins>
          <!-- This dependency-only module has no Java API for javadoc:jar to render. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.4.1</version>
            <executions>
              <execution>
                <id>dependency-only-javadoc</id>
                <phase>package</phase>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classifier>javadoc</classifier>
                  <classesDirectory>${project.basedir}/src/main/javadoc</classesDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
