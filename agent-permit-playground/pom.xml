<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.github.agentpermit4j</groupId><artifactId>agent-permit4j</artifactId><version>0.5.0</version></parent>
  <artifactId>agent-permit-playground</artifactId>
  <name>AgentPermit4j :: Playground</name>
  <dependencies>
    <dependency><groupId>io.github.agentpermit4j</groupId><artifactId>agent-permit-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.github.agentpermit4j</groupId><artifactId>agent-permit-policy</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.github.agentpermit4j</groupId><artifactId>agent-permit-execution</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.github.agentpermit4j</groupId><artifactId>agent-permit-approval</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.github.agentpermit4j</groupId><artifactId>agent-permit-audit</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.github.agentpermit4j</groupId><artifactId>agent-permit-spring-ai</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.github.agentpermit4j</groupId><artifactId>agent-permit-jdbc</artifactId><version>${project.version}</version></dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-model</artifactId>
      <version>${spring-ai.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <id>run-playground</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.github.agentpermit4j.playground.PlaygroundApplication</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>run-web</id>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.github.agentpermit4j.playground.PlaygroundWebApplication</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>run-refund</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.github.agentpermit4j.playground.refund.RefundDemo</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
